# Copy this file to .env.local and fill in your keys.
# Keys are used only on the server — they are never sent to the browser.

# Anthropic API key — powers the clinical simulation engine.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini API key — renders the bedside image of the patient so each case
# shows the actual pathology (the bleeding trauma patient, the febrile toddler,
# the jaundiced drinker) instead of a generic portrait. Optional: leave it blank
# and the simulator runs exactly as before, just without patient imagery.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin a specific Gemini image model. Left blank, the server tries
# gemini-3.1-flash-image-preview, then gemini-2.5-flash-image, then
# gemini-3-pro-image-preview, and remembers the first one your key can use.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: route Gemini calls through a proxy or compatible gateway.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional: port for the local server (defaults to 3000)
# PORT=3000
