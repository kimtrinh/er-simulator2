# Copy this file to .env.local and fill in ONE key.
# Keys are used only on the server — they are never sent to the browser.

# Option A (free): Google Gemini API key. Create one at https://aistudio.google.com/apikey
# and don't attach billing — the free tier runs the whole simulator, within Google's
# per-minute and daily rate limits. Google may use free-tier prompts to improve its
# products, so never enter real patient details.
GEMINI_API_KEY=

# Option B (paid): Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: pick the engine when both keys are set (defaults to Claude if its key is set).
# AI_PROVIDER=gemini

# Optional: override the model for either engine.
# GEMINI_MODEL=gemini-flash-latest
# CLAUDE_MODEL=claude-opus-4-8

# Optional: port for the local server (defaults to 3000)
# PORT=3000
