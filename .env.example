# Copy this file to .env.local.
#
# The site is bring-your-own-key: every player pastes their own Gemini (free) or
# Claude key into the site's "API Key" settings, and it's used only for their own
# requests. You don't need anything in this file to run it.
#
# Optional, owner only: let requests that carry OWNER_ACCESS_CODE use the keys below,
# so you can play without pasting a key. Without OWNER_ACCESS_CODE these keys are
# never used. Keys are used only on the server — they are never sent to the browser.
# OWNER_ACCESS_CODE=choose-a-long-private-passphrase
# GEMINI_API_KEY=        # free: https://aistudio.google.com/apikey (no billing needed)
# ANTHROPIC_API_KEY=     # paid: https://console.anthropic.com/
# AI_PROVIDER=gemini     # which owner key to use when both are set (default: Claude if set)

# Optional: override the model for either engine.
# GEMINI_MODEL=gemini-flash-latest
# CLAUDE_MODEL=claude-opus-4-8

# Optional: port for the local server (defaults to 3000)
# PORT=3000
